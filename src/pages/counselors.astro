---
import Base from '../layouts/Base.astro';
---

<Base
  title="For Counselors | Credits That Count"
  description="Credits That Count for school counselors, independent counselors, tutoring centers, homeschool co-ops, and advising organizations. Join the counselor list."
>
  <div class="container">
    <section class="block" style="margin-top:26px;">
      <h1>For counselors and advising organizations</h1>
      <p>
        Built for school counselors, independent counselors, tutoring
        centers, homeschool co-ops, and advising organizations who guide
        Louisiana students through dual enrollment and transfer decisions.
      </p>
      <div class="cards two">
        <div class="card">
          <h3>What seats include</h3>
          <ul>
            <li>A roster for all of your students</li>
            <li>A transfer check for every student you serve</li>
            <li>Semester re-checks as catalogs change</li>
            <li>Every check dated, edition stamped, and sourced</li>
          </ul>
        </div>
        <div class="card">
          <h3>Pricing</h3>
          <p class="price">Per seat <small>/ month</small></p>
          <p class="muted">
            Seat pricing is shared with the counselor list first, before
            public launch.
          </p>
        </div>
      </div>
    </section>

    <section class="block">
      <div class="card">
        <h2>Join the counselor list</h2>
        <p class="muted">
          Tell us where to reach you and roughly how many students you serve.
          We will write back when seats open.
        </p>
        <form class="intake" id="counselor-form">
          <label for="cf-name">Your name</label>
          <input id="cf-name" name="name" type="text" autocomplete="name" required />

          <label for="cf-org">Organization</label>
          <input id="cf-org" name="organization" type="text" autocomplete="organization" required />

          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />

          <label for="cf-students">Approximate number of students</label>
          <input id="cf-students" name="students" type="text" inputmode="numeric" />

          <button class="btn" type="submit">Join the Counselor List</button>
          <p class="fine" style="margin-top:12px;">
            By joining, you confirm you may share this contact information
            with us so we can write back about counselor seats. We never sell
            contact information. See our <a href="/privacy/">privacy page</a>.
          </p>
        </form>
        <p class="fine" id="cf-status" role="status" aria-live="polite" style="margin-top:12px;"></p>
      </div>
    </section>

    <p class="tagline-foot">Know before you go.</p>
  </div>

  <script>
    const form = document.getElementById('counselor-form');
    const status = document.getElementById('cf-status');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      status.textContent = 'Sending...';
      try {
        const response = await fetch(
          'https://credits-that-count-api.onrender.com/api/capture',
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              kind: 'counselor',
              email: data.get('email'),
              counselor: {
                name: data.get('name'),
                organization: data.get('organization'),
                students: data.get('students') || '',
              },
            }),
          }
        );
        if (!response.ok) throw new Error('capture failed');
        form.reset();
        status.textContent =
          'Thank you. You are on the counselor list, and we will write back from plans@creditsthatcount.com.';
      } catch (error) {
        status.textContent =
          'That did not go through. Please email us at plans@creditsthatcount.com instead.';
      } finally {
        button.disabled = false;
      }
    });
  </script>
</Base>
