---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found | Credits That Count"
  description="This page does not exist on Credits That Count. Head back to the home page or run the free credit checker."
>
  <div class="container">
    <section class="block" style="margin-top:26px;">
      <h2>This page does not exist.</h2>
      <p>
        The address may have been typed wrong, or the page may have moved.
        Nothing is lost: the checker and the rest of the site are right
        here.
      </p>
      <p>
        <a class="btn" href="/checker/">Check My Credits</a>
      </p>
      <p>
        Or go to the <a href="/">home page</a> and start from there.
      </p>
    </section>

    <p class="tagline-foot">Know before you go.</p>
  </div>
</Base>
