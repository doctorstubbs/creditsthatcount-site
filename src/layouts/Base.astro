---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  hideNav?: boolean;
}

const { title, description, hideNav } = Astro.props;
const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          name: 'Credits That Count',
          url: 'https://creditsthatcount.com/',
          email: 'plans@creditsthatcount.com',
          logo: 'https://creditsthatcount.com/og-image.png',
          areaServed: { '@type': 'State', name: 'Louisiana' },
          address: { '@type': 'PostalAddress', addressLocality: 'New Orleans', addressRegion: 'LA', addressCountry: 'US' },
        },
        {
          '@type': 'WebSite',
          name: 'Credits That Count',
          url: 'https://creditsthatcount.com/',
        },
      ],
    })} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://creditsthatcount.com/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#1d3fae" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">Credits That <span>Count</span></a>
        {!hideNav && (
          <nav class="main-nav" aria-label="Main">
            <a href="/checker/">Check My Credits</a>
            <a href="/how-it-works/">How It Works</a>
            <a href="/counselors/">For Counselors</a>
            <a href="/privacy/">Privacy</a>
          </nav>
        )}
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav aria-label="Footer">
          <a href="/checker/">Check My Credits</a>
          <a href="/how-it-works/">How It Works</a>
          <a href="/counselors/">For Counselors</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
        <p>
          Questions? Write to us at
          <a href="mailto:plans@creditsthatcount.com">plans@creditsthatcount.com</a>.
        </p>
        <p>
          Our Credit Transfer Pros are former and current higher education
          administrators with experience in college student affairs,
          admissions, and student success.
        </p>
        <p>
          Credits That Count provides guidance built from published sources.
          Only the receiving college makes the final decision on how a credit
          applies.
        </p>
        <p>&copy; {year} Credits That Count. All rights reserved.</p>
      </div>
    </footer>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
